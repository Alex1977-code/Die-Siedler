+  /// Nimmt fallengelassene Text- und Markdown-Dateien in den Massenprompt.
+  ///
+  /// Der Weg vorher war: Datei oeffnen, alles markieren, kopieren, hier
+  /// einfuegen. Bei 43 Bloecken ueber 48 KB ist das fehleranfaellig - genau
+  /// dort gehen die Trennzeilen "---" verloren.
+  ///
+  /// Ist das Feld leer, wird der Inhalt gesetzt; steht schon etwas drin,
+  /// wird ANGEHAENGT statt ersetzt. Getipptes geht damit nie verloren, und
+  /// mehrere Listen lassen sich nacheinander hineinziehen. Zwischen zwei
+  /// Dateien kommt eine Trennzeile, aber nur wenn nicht ohnehin schon eine
+  /// dasteht - sonst entstuende ein leerer Block.
+  Future<void> _dropBatchText(List<XFile> files) async {
+    const erlaubt = ['.txt', '.md', '.markdown', '.text', '.prompt'];
+    final stuecke = <String>[];
+    var uebersprungen = 0;
+    for (final file in files) {
+      final name = file.name.toLowerCase();
+      if (!erlaubt.any(name.endsWith)) {
+        uebersprungen++;
+        continue;
+      }
+      final bytes = await file.readAsBytes();
+      // allowMalformed: eine Datei in Latin-1 soll nicht die ganze
+      // Uebernahme sprengen - dann stehen eben einzelne Zeichen falsch.
+      var text = utf8.decode(bytes, allowMalformed: true);
+      if (text.startsWith('\uFEFF')) text = text.substring(1); // BOM
+      text = text.replaceAll('\r\n', '\n').trim();
+      if (text.isNotEmpty) stuecke.add(text);
+    }
+    if (!mounted) return;
+    if (stuecke.isEmpty) {
+      setState(() => _dragOverBatch = false);
+      _showSnack(uebersprungen > 0
+          ? '$uebersprungen Datei(en) uebersprungen - hierher passen nur '
+              'Text- und Markdown-Dateien (.txt, .md).'
+          : 'Die Datei war leer.');
+      return;
+    }
+    final vorher = _batchCtrl.text.trimRight();
+    final neu = stuecke.join('\n---\n');
+    final String zusammen;
+    if (vorher.isEmpty) {
+      zusammen = neu;
+    } else if (vorher.endsWith('---')) {
+      zusammen = '$vorher\n$neu';
+    } else {
+      zusammen = '$vorher\n---\n$neu';
+    }
+    setState(() {
+      _dragOverBatch = false;
+      _batchCtrl.text = zusammen;
+      _batchCtrl.selection =
+          TextSelection.collapsed(offset: _batchCtrl.text.length);
+    });
+    // Nur ZEILEN, die genau aus drei Bindestrichen bestehen, trennen
+    // Bloecke. Ein '---' mitten in einer Beschreibung zaehlt nicht mit.
+    final bloecke = zusammen
+            .split('\n')
+            .where((z) => z.trim() == '---')
+            .length +
+        1;
+    _showSnack(vorher.isEmpty
+        ? '${stuecke.length} Datei(en) uebernommen, $bloecke Block/Bloecke.'
+        : '${stuecke.length} Datei(en) angehaengt, jetzt $bloecke Block/Bloecke.'
+            '${uebersprungen > 0 ? ' $uebersprungen uebersprungen.' : ''}');
+  }
+
